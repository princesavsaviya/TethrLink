# ── Debian package payload (generated by build_deb.sh — do not hand-edit) ────
# Everything under usr/lib/tethrlink/ is copied from server/ and pip-installed
# at build time. The rest of debian_build/ (DEBIAN/control, postinst, postrm,
# usr/bin/tethrlink, the .desktop file, icons) is hand-maintained and stays
# tracked.
debian_build/usr/lib/tethrlink/

